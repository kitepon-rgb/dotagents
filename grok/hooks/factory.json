{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-git-destroy-gate-hook",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "spawn_subagent|Task|Agent|aiterm__.*_agent|mcp__aiterm__.*_agent|codex-sidecar__codex_.*|mcp__codex-sidecar__codex_.*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-delegation-gate-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-todo-gate-hook session-start",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-lattice-gantt-hook session-start",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-orchestrate-advisory-hook",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-onset-gate-hook",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-lattice-gantt-hook user-prompt-submit",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-todo-gate-hook stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "exit_plan_mode|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.local/bin/grok-plan-gate-hook",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
